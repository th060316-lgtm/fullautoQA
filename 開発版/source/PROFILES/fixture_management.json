{
  "game_id": "fixture_management",
  "game_version": "1.0",
  "profile_version": "3.1",
  "schema_version": 1,
  "adapter_version": "1.0",
  "prototype_type": "playable",
  "source": "GAME/fixtures",
  "launch": {
    "argv": [
      "{godot}",
      "--path",
      "{work}",
      "--",
      "--mode",
      "management",
      "--bridge",
      "{work}/state.json",
      "--seed",
      "{seed}"
    ]
  },
  "build": {
    "argv": [
      "{godot}",
      "--headless",
      "--path",
      "{work}",
      "--editor",
      "--import",
      "--quit"
    ],
    "timeout": 120
  },
  "required_assets": [
    "project.godot",
    "main.tscn",
    "fixture.gd"
  ],
  "bridge": "state.json",
  "actions": {
    "move_right": {
      "inputs": [
        {
          "kind": "hold",
          "key": "RIGHT",
          "duration": 0.2
        }
      ]
    },
    "move_left": {
      "inputs": [
        {
          "kind": "hold",
          "key": "LEFT",
          "duration": 0.2
        }
      ]
    },
    "move_down": {
      "inputs": [
        {
          "kind": "hold",
          "key": "DOWN",
          "duration": 0.2
        }
      ]
    },
    "move_up": {
      "inputs": [
        {
          "kind": "hold",
          "key": "UP",
          "duration": 0.2
        }
      ]
    },
    "confirm": {
      "inputs": [
        {
          "kind": "key",
          "key": "ENTER"
        }
      ]
    },
    "cancel": {
      "inputs": [
        {
          "kind": "key",
          "key": "ESC"
        }
      ]
    },
    "select": {
      "inputs": [
        {
          "kind": "key",
          "key": "TAB"
        }
      ]
    },
    "choice_one": {
      "inputs": [
        {
          "kind": "key",
          "key": "1"
        }
      ]
    },
    "choice_two": {
      "inputs": [
        {
          "kind": "key",
          "key": "2"
        }
      ]
    },
    "build": {
      "inputs": [
        {
          "kind": "key",
          "key": "B"
        }
      ]
    },
    "next_turn": {
      "inputs": [
        {
          "kind": "key",
          "key": "N"
        }
      ]
    },
    "save": {
      "inputs": [
        {
          "kind": "key",
          "key": "F5"
        }
      ]
    },
    "load": {
      "inputs": [
        {
          "kind": "key",
          "key": "F9"
        }
      ]
    },
    "fail": {
      "inputs": [
        {
          "kind": "key",
          "key": "F"
        }
      ]
    },
    "retry": {
      "inputs": [
        {
          "kind": "key",
          "key": "R"
        }
      ]
    }
  },
  "controls": {
    "move": "arrows",
    "confirm": "ENTER",
    "save": "F5",
    "load": "F9"
  },
  "observations": [
    "internal_state",
    "numeric_state",
    "scene",
    "position",
    "timer",
    "screenshot",
    "window",
    "process"
  ],
  "goals": [
    {
      "id": "main",
      "type": "build",
      "field": "goal",
      "op": "eq",
      "value": true
    }
  ],
  "victory": {
    "field": "goal",
    "op": "eq",
    "value": true
  },
  "defeat": {
    "field": "failed",
    "op": "eq",
    "value": true
  },
  "save": {
    "file": "qa_save.json",
    "save_action": "save",
    "load_action": "load",
    "mutate_action": "confirm",
    "state_fields": [
      "turn",
      "score",
      "dialogue",
      "reaction"
    ],
    "invalid_expected": {
      "field": "load_error",
      "op": "eq",
      "value": true
    }
  },
  "timeout": 120,
  "startup_timeout": 30,
  "stall_seconds": 5,
  "screenshot_interval": 3,
  "disk_reserve_mb": 512,
  "evidence_limit_mb": 8192,
  "allowed_random_actions": [
    "move_right",
    "move_down",
    "confirm",
    "next_turn",
    "choice_one",
    "choice_two",
    "build",
    "select"
  ],
  "forbidden_actions": [],
  "expected_states": [
    {
      "field": "scene",
      "op": "eq",
      "value": "play"
    }
  ],
  "error_states": [
    {
      "field": "money",
      "op": "lt",
      "value": 0,
      "reason": "NEGATIVE_RESOURCE"
    }
  ],
  "normal_wait_states": [
    {
      "field": "scene",
      "op": "eq",
      "value": "menu"
    },
    {
      "field": "scene",
      "op": "eq",
      "value": "failure"
    }
  ],
  "state_signature": [
    "scene",
    "position",
    "turn",
    "score",
    "money",
    "branch",
    "dialogue",
    "goal"
  ],
  "instructions": "Arrows move/select; Enter confirms; B builds; N ends turn; 1/2 choose a story branch. F5 saves, F9 loads. Esc toggles menu. F fails; R retries. Goal is shown in the scene state.",
  "scenarios": [
    {
      "id": "smoke",
      "agent": "Smoke",
      "sequence": [
        "cancel",
        "cancel",
        "confirm"
      ],
      "action_budget": 3,
      "time_budget": 15
    },
    {
      "id": "explorer",
      "agent": "Explorer",
      "action_budget": 25,
      "time_budget": 20
    },
    {
      "id": "goal",
      "agent": "Goal",
      "sequence": [
        "build",
        "build",
        "build",
        "next_turn",
        "next_turn"
      ],
      "goal": "main",
      "action_budget": 40,
      "time_budget": 40,
      "save_load": true
    },
    {
      "id": "random",
      "agent": "Random",
      "action_budget": 30,
      "time_budget": 30,
      "verify_seed_replay": false,
      "replay_fields": [
        "score",
        "turn",
        "event"
      ]
    }
  ],
  "tests": [
    {
      "id": "feedback",
      "scenario": "smoke",
      "expect": {
        "field": "reaction",
        "op": "ge",
        "value": 1
      }
    }
  ],
  "generated_paths": [
    "qa_save.json",
    "state.json"
  ],
  "display": {
    "kind": "windows"
  },
