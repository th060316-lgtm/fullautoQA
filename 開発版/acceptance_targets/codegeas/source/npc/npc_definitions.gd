## Get all NPC IDs
static func get_all_npc_ids() -> Array:
	return NPC_TEMPLATES.keys().filter(func(id): return id != "yui")

## Get heroine ID
static func get_heroine_id() -> String:
	return "yui"

## Get NPC by ID
static func get_npc(id: String) -> Dictionary:
	return NPC_TEMPLATES.get(id, {})

## Create a deep copy of NPC data for runtime use
static func create_runtime_copy(id: String) -> Dictionary:
	var template = NPC_TEMPLATES.get(id, {})
	if template.is_empty():
		return {}
	return template.duplicate(true)
