extends Node

var game: Node = null
var ui: Control = null
var map_view: Control = null


func _ready() -> void:
	call_deferred("_bind")


func _bind() -> void:
	game = get_node_or_null("../GameController")
	ui = get_node_or_null("../UI")
	map_view = get_node_or_null("../UI/MapView")
	var bridge = get_node_or_null("/root/QaBridge")
	if bridge != null:
		bridge.set_adapter(self)


func qa_input_event(action: Dictionary) -> bool:
	# This is an InputEvent transport, not a state-mutation API. It deliberately
	# traverses the same viewport/Control/GameController input path as a person.
	var kind := str(action.get("kind", ""))
	if kind == "click" or kind == "key":
		call_deferred("_dispatch_input_event", action.duplicate(true))
		return true
	return false


func _dispatch_input_event(action: Dictionary) -> void:
	var kind := str(action.get("kind", ""))
	if kind == "click":
		var position := Vector2(float(action.get("x", 0)), float(action.get("y", 0)))
		var button := MOUSE_BUTTON_RIGHT if str(action.get("button", "left")) == "right" else MOUSE_BUTTON_LEFT
		var motion := InputEventMouseMotion.new()
		motion.position = position
		motion.global_position = position
		get_viewport().push_input(motion, true)
		var mouse_press := InputEventMouseButton.new()
		mouse_press.button_index = button
		mouse_press.position = position
		mouse_press.global_position = position
		mouse_press.pressed = true
		get_viewport().push_input(mouse_press, true)
		await get_tree().process_frame
		var mouse_release := InputEventMouseButton.new()
		mouse_release.button_index = button
		mouse_release.position = position
		mouse_release.global_position = position
		mouse_release.pressed = false
		get_viewport().push_input(mouse_release, true)
		return
	if kind == "key":
		var key_name := str(action.get("key", "")).to_upper()
		var code := KEY_NONE
		if key_name == "X":
			code = KEY_X
		elif key_name == "ESC" or key_name == "ESCAPE":
			code = KEY_ESCAPE
		if code == KEY_NONE:
			return
		var key_press := InputEventKey.new()
		key_press.keycode = code
		key_press.physical_keycode = code
		key_press.pressed = true
		get_viewport().push_input(key_press, true)
		await get_tree().process_frame
		var key_release := InputEventKey.new()
		key_release.keycode = code
		key_release.physical_keycode = code
		key_release.pressed = false
		get_viewport().push_input(key_release, true)


func qa_get_state() -> Dictionary:
	if game == null or game.world == null:
		_bind()
	if game == null or game.world == null:
		return {"qa_ready": false, "goal_status": "running", "legal_actions": []}
	var w: WorldState = game.world
	var state := {
		"qa_ready": true,
		"scene": get_tree().current_scene.name if get_tree().current_scene else "",
		"goal_status": "running",
		"day": w.day,
		"money": w.money,
		"paused": game.paused,
		"time_scale": game.time_scale,
		"build_mode": game.build_mode,
		"selected_settlement_id": game.selected_settlement_id,
		"selected_route_id": game.selected_route_id,
		"viewport": _viewport_state(),
		"grid": _grid_state(),
		"war": _war_state(),
		"nations": _nation_states(),
		"settlements": _settlement_states(),
		"routes": _route_states(),
		"companies": _company_states(),
		"industry_facilities": _industry_facility_states(),
		# WorldState stores newest entries first. Expose the newest slice so an
		# expected-rejection action can verify the reason generated by that action.
		"event_log": w.event_log.slice(0, mini(12, w.event_log.size())),
		"ui_buttons": _button_states(),
	}
	state["legal_actions"] = _legal_actions(state)
	state["qa_warnings"] = _ui_warnings(state)
	return state


func _viewport_state() -> Dictionary:
	var size := get_viewport().get_visible_rect().size
	return {"width": size.x, "height": size.y}


func _grid_state() -> Dictionary:
	if game.world.ground == null:
		return {}
	var g: GroundNetwork = game.world.ground
	return {
		"origin_x": g.GRID_ORIGIN.x,
		"origin_y": g.GRID_ORIGIN.y,
		"tile_size": g.TILE_SIZE,
		"cols": g.COLS,
		"rows": g.ROWS,
		"road_tiles": g.count_infra(Route.RouteType.ROAD),
		"rail_tiles": g.count_infra(Route.RouteType.RAIL),
	}


func _war_state() -> Dictionary:
	var w: WorldState = game.world
	return {
		"active": w.war_active,
		"nation_a": w.war_nation_a,
		"nation_b": w.war_nation_b,
		"days_left": w.war_days_left,
		"supply_base_ids": w.war_supply_base_ids.duplicate(),
	}


func _nation_states() -> Array:
	var out: Array = []
	for n in game.world.nations:
		out.append({
			"id": n.id,
			"name": n.name,
			"stability": n.stability,
			"power": n.power,
			"war_bonus": n.war_bonus,
			"is_at_war": n.is_at_war,
			"war_opponent_id": n.war_opponent_id,
		})
	return out


func _settlement_states() -> Array:
	var out: Array = []
	var w: WorldState = game.world
	for s in w.settlements:
		var term := Vector2i(-1, -1)
		if w.ground != null and w.ground.terminals.has(s.id):
			term = w.ground.get_terminal(s.id)
		var port_capable := false
		var airport_capable := false
		if game.ship_system != null:
			port_capable = game.ship_system.is_port_capable(s)
		if game.air_system != null:
			airport_capable = game.air_system.is_airport_capable(s)
		out.append({
			"id": s.id,
			"name": s.name,
			"x": s.position.x,
			"y": s.position.y,
			"nation_id": s.nation_id,
			"active": s.active,
			"is_supply_base": s.is_supply_base,
			"support_nation_id": s.support_nation_id,
			"population": s.population,
			"economy": s.economy,
			"economy_state": s.economy_state,
			"food_demand": s.food_demand,
			"fuel_demand": s.fuel_demand,
			"passenger_demand": s.passenger_demand,
			"food_supply_capacity": s.food_supply_capacity,
			"fuel_supply_capacity": s.fuel_supply_capacity,
			"development_support": s.development_support,
			"promotion_support": s.promotion_support,
			"investment_support": s.investment_support,
			"reconstruction_demand": s.reconstruction_demand,
			"war_damage": s.war_damage,
			"has_port": s.has_port,
			"has_airport": s.has_airport,
			"port_capable": port_capable,
			"airport_capable": airport_capable,
			"terminal_x": term.x,
			"terminal_y": term.y,
		})
	return out


func _route_states() -> Array:
	var out: Array = []
	var w: WorldState = game.world
	for r in w.routes:
		var connected := true
		if w.ground != null and (r.type == Route.RouteType.ROAD or r.type == Route.RouteType.RAIL):
			connected = w.ground.has_settlement_connection(r.from_id, r.to_id, r.type)
		out.append({
			"id": r.id,
			"from_id": r.from_id,
			"to_id": r.to_id,
			"type": r.type,
			"company_id": r.company_id,
			"active": r.active,
			"obsolete": r.obsolete,
			"connected": connected,
			"capacity": r.capacity,
			"last_revenue": r.last_revenue,
			"daily_revenue": r.daily_revenue,
			"profit": r.profit,
			"market_share": r.market_share,
			"total_carried": r.total_carried,
			"unprofitable_days": r.unprofitable_days,
		})
	return out


func _company_states() -> Array:
	var out: Array = []
	for c in game.world.companies:
		out.append({
			"id": c.company_id,
			"name": c.company_name,
			"is_player": c.is_player,
			"money": c.money,
			"last_day_revenue": c.last_day_revenue,
			"last_day_expense": c.last_day_expense,
			"total_revenue": c.total_revenue,
			"total_expenses": c.total_expenses,
			"lifetime_profit": c.lifetime_profit,
			"route_count": c.get_connection_count(),
			"reputation": c.reputation,
		})
	return out


func _industry_facility_states() -> Array:
	var out: Array = []
	if game == null or game.world == null:
		return out
	for f in game.world.industry_facilities:
		out.append({
			"id": int(f.get("id", -1)),
			"settlement_id": int(f.get("settlement_id", -1)),
			"type": str(f.get("type", "")),
			"builder_company_id": int(f.get("builder_company_id", -1)),
			"owner_company_id": int(f.get("owner_company_id", -1)),
			"operator_id": str(f.get("operator_id", "")),
			"status": str(f.get("status", "")),
			"start_day": int(f.get("start_day", 0)),
			"completion_day": int(f.get("completion_day", 0)),
			"cost": float(f.get("cost", 0.0)),
		})
	return out


func _button_states() -> Array:
	var out: Array = []
	if ui == null:
		return out
	var buttons: Array[Button] = []
	_collect_buttons(ui, buttons)
	for b in buttons:
		if not b.visible:
			continue
		var rect := b.get_global_rect()
		out.append({
			"text": b.text,
			"x": rect.get_center().x,
			"y": rect.get_center().y,
			"left": rect.position.x,
			"top": rect.position.y,
			"right": rect.end.x,
			"bottom": rect.end.y,
			"disabled": b.disabled,
		})
	return out


func _collect_buttons(node: Node, out: Array[Button]) -> void:
	for child in node.get_children():
		if child is Button:
			out.append(child)
		_collect_buttons(child, out)


func _button_tag(text: String) -> String:
	if text.begins_with("道路建設"):
		return "build_road"
	if text.begins_with("鉄道建設"):
		return "build_rail"
	if text.begins_with("撤去"):
		return "remove"
	if text == "x1":
		return "speed_x1"
	if text == "x5":
		return "speed_x5"
	if text == "Pause":
		return "pause"
	if text.begins_with("強制開戦"):
		return "force_war"
	if text.begins_with("船舶航路"):
		return "build_ship"
	if text.begins_with("航空路"):
		return "build_air"
	if text.begins_with("港"):
		return "build_port"
	if text.begins_with("空港"):
		return "build_airport"
	if text == "都市支援":
		return "support_city"
	if text == "宣伝":
		return "promote_city"
	if text == "地域投資":
		return "invest_region"
	if text == "産業建設":
		return "build_industry"
	return "button"


func _legal_actions(state: Dictionary) -> Array:
	var out: Array = []
	for b in state.get("ui_buttons", []):
		if b.get("disabled", false):
			continue
		var tag := _button_tag(str(b.get("text", "")))
		out.append({
			"id": "ui:%s" % tag,
			"kind": "click",
			"x": int(b.get("x", 0)),
			"y": int(b.get("y", 0)),
			"coordinate_space": "client",
			"button": "left",
			"tag": tag,
			"priority": 20,
		})
	for s in state.get("settlements", []):
		if not s.get("active", false):
			continue
		out.append({
			"id": "settlement:%d" % int(s.id),
			"kind": "click",
			"x": int(s.x),
			"y": int(s.y),
			"coordinate_space": "client",
			"button": "left",
			"tag": "select_settlement",
			"settlement_id": int(s.id),
			"priority": 10,
		})
	var settlements_by_id := {}
	for s in state.get("settlements", []):
		settlements_by_id[int(s.id)] = s
	for r in state.get("routes", []):
		if not r.get("active", false):
			continue
		var from_id := int(r.get("from_id", -1))
		var to_id := int(r.get("to_id", -1))
		if not settlements_by_id.has(from_id) or not settlements_by_id.has(to_id):
			continue
		var a: Dictionary = settlements_by_id[from_id]
		var b: Dictionary = settlements_by_id[to_id]
		out.append({
			"id": "route:%d" % int(r.id),
			"kind": "click",
			"x": int((float(a.x) + float(b.x)) * 0.5),
			"y": int((float(a.y) + float(b.y)) * 0.5),
			"coordinate_space": "client",
			"button": "left",
			"tag": "select_route",
			"route_id": int(r.id),
			"priority": 8,
		})
	return out


func _ui_warnings(state: Dictionary) -> Array:
	var warnings: Array = []
	var vp: Dictionary = state.get("viewport", {})
	var width := float(vp.get("width", 0.0))
	var height := float(vp.get("height", 0.0))
	for b in state.get("ui_buttons", []):
		if float(b.get("left", 0.0)) < 0.0 or float(b.get("right", 0.0)) > width or float(b.get("top", 0.0)) < 0.0 or float(b.get("bottom", 0.0)) > height:
			warnings.append("UI button clipped/offscreen: %s" % str(b.get("text", "?")))
	return warnings

