; Engine configuration file.
; Godot 4.x project for EXT-20261018-007 Grok Core Implementation
; ギアス災害サバイバル 最小試作 - Core 50%

config_version=5

[application]

config/name="GeassDisasterSurvival_Core"
config/description="最小試作 Core基盤 (Grok担当50%) - 未検証外部成果"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.2", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://core/EventBus.gd"
RngService="*res://core/RngService.gd"
GameState="*res://core/GameState.gd"
CampaignManager="*res://sandbox/CampaignManager.gd"
NpcManager="*res://npc/npc_manager.gd"
MemorySystem="*res://memory/memory_system.gd"
EmotionSystem="*res://social/emotion_system.gd"
HeroineSystem="*res://social/heroine_system.gd"
MaleFriendEstimator="*res://social/male_friend_estimator.gd"
WorldEventSystem="*res://world/world_event_system.gd"
GeassSystem="*res://world/geass_system.gd"
QuestManager="*res://quests/quest_manager.gd"
EndingSystem="*res://world/ending_system.gd"
DebugHooks="*res://tests/debug_hooks.gd"
SocialManager="*res://autoload/SocialManager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

