    action="append",
    default=[],
    choices=[
        "fast-deps",
        "inprocess-build-deps",
        "venv-isolation",
    ]
    + ALWAYS_ENABLED_FEATURES,
    help="Enable new functionality, that may be backward incompatible.",
)

