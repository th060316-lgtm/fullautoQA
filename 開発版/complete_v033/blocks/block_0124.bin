__title__ = "packaging"
__summary__ = "Core utilities for Python packages"
__uri__ = "https://github.com/pypa/packaging"

__version__ = "26.2"

__author__ = "Donald Stufft and individual contributors"
__email__ = "donald@stufft.io"

