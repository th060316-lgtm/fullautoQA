        return os.path.expanduser("~/Desktop")  # noqa: PTH111

    @property
    def user_projects_dir(self) -> str:
        """:returns: projects directory tied to the user, e.g. ``~/Projects``"""
        return os.path.expanduser("~/Projects")  # noqa: PTH111

    @property
