body {
    background-color: #f0f0f8;
}

table.heading tr {
    background-color: #7799ee;
}

.decor {
    color: #ffffff;
}

.title-decor {
    background-color: #ffc8d8;
    color: #000000;
}

.pkg-content-decor {
    background-color: #aa55cc;
}

.index-decor {
    background-color: #ee77aa;
}

.functions-decor {
