    set tixOption(active_bg)    $tixOption(dark1_bg)
    set tixOption(active_fg)    $tixOption(fg)
    set tixOption(disabled_fg)  SystemDisabledText

    set tixOption(input1_bg)    SystemWindow
#     set tixOption(input2_bg)    
