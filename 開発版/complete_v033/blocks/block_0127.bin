  "schema_version": 1,
  "version": "0.3.3-candidate",
  "target_product": "Offline game-specific automated QA harness",
  "functional_validation_backend": "RFB 3.8 software virtual display",
  "required_host_capabilities": [
    "process",
    "key_input",
    "screenshot",
    "video"
  ],
  "required_product_capabilities": [],
  "optional_host_capabilities": [
    "ocr",
    "audio",
    "gamepad"
  ],
  "policy": "Unsupported optional host capabilities do not poison a target run. Missing target-declared requirements block target certification. Native backend/package qualification is reported separately.",
  "required_tools": [],
  "recording": {
    "required_capability": "continuous_video_evidence",
    "preferred_backends": [
      "desktop_ffmpeg",
      "captured_frames"
    ],
    "tool_policy": "Bundling ten payloads does not require every tool to run for every profile. A required tool declaration must include a product justification."
  },
  "paths": {
    "results": "RESULTS",
    "profiles": "PROFILES",
    "validation_profiles": "VALIDATION_PROFILES",
    "target_manifest": "QA_TARGETS.json"
  },
  "implemented_campaigns": [
    "native_fault_suite",
    "duration_loop_soak",
    "portable_cross_run_regression",
    "target_game_binding",
    "selftest_target_separation"
  ],
  "native_runtime_backends": [
    "windows_x64"
  ],
  "package_qualification": {
    "windows_x64": [
      "windows_desktop_e2e",
      "ten_windows_toolchains"
    ],
    "policy": "Backend/package qualification is separate from target-game QA certification."
  }
