    set ent [$w nearest $x $y]
    if {$ent != ""} {
	$w anchor set $ent
        $w see $ent
	$w selection clear
	$w selection set $ent
	tixTList:CallBrowseCmd $w $ent
    }
}

proc tixTList:GoState-b5 {w} {
    tixTList:StartScan $w
}

proc tixTList:GoState-b6 {w} {
