        ),
        pytest.param(
            PEP621_INTERNATIONAL_EMAIL_EXAMPLE,
            'Ankit Ahlawat <à¤…à¤‚à¤•à¤¿à¤¤@à¤‰à¤¦à¤¾à¤¹à¤°à¤£.à¤­à¤¾à¤°à¤¤>',
            marks=pytest.mark.xfail(
